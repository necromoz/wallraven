# Production project id: mcjoigrvejwyzrxllwqu

SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Server-only, never prefixed VITE_. Set in the hosting platform's environment,
# not in a committed file.
