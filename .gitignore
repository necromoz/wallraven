# Electron build artifacts (externalized, never committed)
# These are what broke Lovable's "connect to GitHub" flow: a packaged build
# leaves ~111 MB installers in electron/, and GitHub rejects any file over
# 100 MB. Keep binaries out of the repo; ship them as release assets.
electron/app/
electron/_pkg/
# Anything parked for deletion: this sandbox cannot delete files on the user's
# machine, so build leftovers get moved here instead of removed.
electron/_to_delete/
electron/out/
electron/dist/
*.exe
*.nupkg
*.pdb
# Store packages are build output too, and each one is ~110 MB.
*.msix
*.msixbundle
*.appx

# Scratch profile used by `npm run app:clean` so a dev run can sit alongside
# the installed copy without sharing its settings, cache or history.
.devprofile/

# Environment files. Only .env.example is committed; keep real values local.
.env
.env.*
!.env.example


# Database export from Lovable. Contains a real Wallhaven API key and
# account data. Never commit it: this repo is public.
/From Lovable/
